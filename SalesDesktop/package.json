{
    "name": "sales-desktop",
    "version": "3.9.6",
    "description": "销售管理系统桌面客户端",
    "author": "Юрий",
    "private": true,
    "type": "module",
    "main": "electron/main.cjs",
    "scripts": {
        "dev": "vite",
        "typecheck": "tsc --noEmit --pretty false",
        "test": "vitest run",
        "build": "vite build",
        "preview": "vite preview",
        "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron . --dev\"",
        "electron:build": "npm run build && electron-builder"
    },
    "dependencies": {
        "@ant-design/icons": "^5.5.0",
        "@tanstack/react-query": "^5.101.2",
        "antd": "^5.22.0",
        "axios": "^1.7.9",
        "dayjs": "^1.11.13",
        "echarts": "^6.1.0",
        "echarts-for-react": "^3.0.6",
        "electron-updater": "^6.8.9",
        "i18next": "^24.2.0",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "react-i18next": "^15.4.0",
        "react-router-dom": "^6.28.0",
        "read-excel-file": "^9.3.2",
        "three": "^0.185.1"
    },
    "devDependencies": {
        "@types/node": "^22.10.0",
        "@types/react": "^18.3.0",
        "@types/react-dom": "^18.3.0",
        "@vitejs/plugin-react": "^4.3.4",
        "concurrently": "^9.1.0",
        "electron": "^43.2.0",
        "electron-builder": "^26.15.3",
        "png-to-ico": "^3.0.2",
        "sharp": "^0.35.3",
        "typescript": "^5.7.0",
        "vite": "^6.0.0",
        "vitest": "^4.1.10",
        "wait-on": "^8.0.0"
    }
}
